# Atari Lynx Space Invaders
# Ubuntu / WSL - cc65

CC65_HOME := /usr/share/cc65
BIN := /usr/bin

CC := $(BIN)/cc65
AS := $(BIN)/ca65
CO := $(BIN)/co65
CL := $(BIN)/cl65

CFG := $(CC65_HOME)/cfg/lynx-coll.cfg
LIB := $(CC65_HOME)/lib/lynx.lib

JOY := $(CC65_HOME)/target/lynx/drv/joy/lynx-stdjoy.joy
TGI := $(CC65_HOME)/target/lynx/drv/tgi/lynx-160-102-16.tgi

CFLAGS := -t lynx -I . -I $(CC65_HOME)/include \
          --add-source -O -Or -Cl -Os

ASFLAGS := -t lynx -I $(CC65_HOME)/asminc

TARGET := spaceInv.lnx

OBJECTS := lynx-160-102-16.o lynx-stdjoy.o \
           sprites.o spaceInv.o

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CL) -t lynx -C $(CFG) \
	    -L $(CC65_HOME)/lib \
	    -o $@ $(OBJECTS) $(LIB)

%.o: %.c
	$(CC) $(CFLAGS) -o $*.s $<
	$(AS) $(ASFLAGS) -o $@ $*.s

lynx-stdjoy.o: $(JOY)
	$(CO) --code-label _lynxjoy -o lynx-stdjoy.s $<
	$(AS) $(ASFLAGS) -o $@ lynx-stdjoy.s

lynx-160-102-16.o: $(TGI)
	$(CO) --code-label _lynxtgi \
	    -o lynx-160-102-16.s $<
	$(AS) $(ASFLAGS) -o $@ lynx-160-102-16.s

clean:
	rm -f $(TARGET) $(OBJECTS) \
	    spaceInv.s sprites.s \
	    lynx-stdjoy.s lynx-160-102-16.s

# Header dependencies
spaceInv.o: spaceInv.c sprites.h consts.h joy_compat.h
sprites.o: sprites.c sprites.h consts.h
